{
  "projects": [
    {
      "id": "self",
      "repository": { "owner": "palgarra14-del", "name": "agente-automatizador" },
      "defaultBranch": "main",
      "workingBranchPattern": "agent/{runId}",
      "protectedBranches": ["main"],
      "workspace": "..",
      "workspaceStrategy": "managed",
      "commandEnvironment": { "NEXT_TELEMETRY_DISABLED": "1" },
      "changePolicy": {
        "forbiddenPaths": [],
        "sensitivePaths": [],
        "budgets": { "maxChangedFiles": 8, "maxDiffLines": 500 }
      },
      "commands": {
        "install": "npm ci",
        "test": "npm test",
        "typecheck": "node --check src/core.js",
        "lint": "npm run lint",
        "build": "npm run build"
      },
      "policies": {
        "requireApprovalFor": ["merge", "production_deploy", "destructive_data_change"],
        "forbidden": ["force_push_main", "delete_protected_branch"]
      },
      "acceptance": { "require": ["install", "test", "typecheck", "lint", "build", "ci"] },
      "deployment": { "provider": "none" },
      "budgets": {
        "maxIterations": 3,
        "maxTasks": 10,
        "maxRuntimeMinutes": 10,
        "maxModelCalls": 0,
        "maxWorkerAttempts": 2,
        "commandTimeoutMs": 30000,
        "ciTimeoutMs": 600000,
        "ciPollIntervalMs": 10000,
        "deploymentTimeoutMs": 600000,
        "deploymentPollIntervalMs": 15000
      }
    },
    {
      "id": "leadfinder",
      "displayName": "LeadFinder",
      "repository": { "owner": "palgarra14-del", "name": "Lead-finder" },
      "defaultBranch": "main",
      "workingBranchPattern": "agent/{runId}",
      "protectedBranches": ["main"],
      "workspace": "..",
      "workspaceStrategy": "managed",
      "commandEnvironment": { "NEXT_TELEMETRY_DISABLED": "1" },
      "changePolicy": {
        "forbiddenPaths": [],
        "sensitivePaths": [],
        "budgets": { "maxChangedFiles": 3, "maxDiffLines": 200 }
      },
      "commands": {
        "install": "pnpm install --frozen-lockfile",
        "test": "pnpm test",
        "lint": "pnpm lint",
        "build": "pnpm build"
      },
      "acceptance": { "require": ["install", "test", "lint", "build", "ci", "deployment"] },
      "deployment": {
        "provider": "vercel",
        "projectId": "prj_ITEH4iBkj6DOmNukkKP2LilTbyrn",
        "teamId": "team_WDwd9ZZgxEdlv4AS0oIP1num",
        "requirePreviewReady": true
      },
      "pullRequest": { "titleTemplate": "Agent: {project} — {objective}" },
      "policies": {
        "requireApprovalFor": ["merge", "production_deploy", "destructive_data_change"],
        "forbidden": ["force_push_main", "delete_protected_branch"]
      },
      "budgets": {
        "maxIterations": 3,
        "maxTasks": 10,
        "maxRuntimeMinutes": 25,
        "maxModelCalls": 0,
        "maxWorkerAttempts": 2,
        "commandTimeoutMs": 300000,
        "ciTimeoutMs": 600000,
        "ciPollIntervalMs": 10000,
        "deploymentTimeoutMs": 600000,
        "deploymentPollIntervalMs": 15000
      }
    }
  ]
}
