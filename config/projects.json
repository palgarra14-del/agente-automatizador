        "copywriting",
        "reservas",
        "catálogo",
        "multidioma",
        "zona privada",
        "ecommerce",
        "otras funciones especiales"
      ],
      "paymentTerms": "Pago estándar: 50 % al inicio y 50 % antes de entrega/publicación.",
      "deliveryWindow": "Plazo habitual: 1–3 semanas desde recibir los materiales y accesos necesarios.",
      "clientResponsibilities": [
